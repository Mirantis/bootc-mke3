---
# yamllint configuration. Run locally with `yamllint .` -- CI runs the same
# command (.github/workflows/lint.yml). Errors fail the run; warnings are
# reported but advisory.
extends: default

rules:
  # Ansible, cloud-init, rpm-ostree treefiles and GitHub workflows in this
  # repo do not open with `---`; requiring it would be pure noise.
  document-start: disable

  # Long shell one-liners and URLs are normal here, so this is advisory.
  line-length:
    max: 160
    allow-non-breakable-words: true
    allow-non-breakable-inline-mappings: true
    level: warning

  # `on:` in GitHub workflows is a key, not a boolean. Only true/false are
  # accepted as values (rejects the YAML 1.1 footguns yes/no/on/off).
  truthy:
    allowed-values: ["true", "false"]
    check-keys: false

  # One space before an inline comment matches the SHA-pin convention used in
  # the workflows (`uses: ...@<sha> # v4.4.0`).
  comments:
    min-spaces-from-content: 1

  # Allow `{ name: x, content: y }` flow mappings (common Ansible style).
  braces:
    min-spaces-inside: 0
    max-spaces-inside: 1

  # The three settings below are required for compatibility with
  # ansible-lint's own yamllint integration (_validate_yamllint_compatibility
  # in ansiblelint/yaml_utils.py). Without them ansible-lint reports this file
  # as incompatible and disables fix mode, and its yaml rule runs degraded.
  # comments.min-spaces-from-content: 1 and the braces values above are also
  # part of that requirement and already comply.
  #
  # ansible-lint handles comment indentation itself; yamllint's check conflicts
  # with it, so it must be disabled here.
  comments-indentation: disable

  # Reject implicit (`0644`) and explicit (`0o644`) octal scalars: YAML 1.1
  # parses `0644` as octal and YAML 1.2 as the integer 644, so an unquoted file
  # mode means different things to different parsers. Quote them instead.
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true

ignore: |
  # Terraform templatefile() inputs: they contain ${...} / %{...} directives
  # and a mandatory `#cloud-config` first line, so they are not plain YAML.
  /terraform/vsphere/helpers/cloudinit/
  # cloud-init user-data must carry `#cloud-config` verbatim on line 1.
  *.cloud-init.yaml
  # Generated MKE client bundle (TLS keys, kubeconfig); gitignored.
  /ansible/mke-bundle/
