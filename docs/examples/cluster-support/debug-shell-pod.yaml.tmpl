# Privileged debug shell Pod for one bootc-mke3 node.
#
# Render with envsubst. Two variables: ${NODE_NAME} is the node, ${NODE_SLUG}
# is the same name with dots replaced, because a pod name containing dots is
# used as the pod's hostname and kubectl warns about it:
#   node=<node>
#   NODE_NAME=$node NODE_SLUG=$(printf '%s' "$node" | tr '.' '-') \
#     envsubst < debug-shell-pod.yaml.tmpl | kubectl apply -f -
#
# Runbook: docs/operations-guide/node-debug-shell.md
# Prerequisite: docs/operations-guide/privileged-support-containers.md
#
# EDIT BEFORE USE: the image tag must match the cluster's MKE version
# (docker version --format '{{.Server.Version}}' with the client bundle sourced
# reports e.g. ucp/3.9.7).
apiVersion: v1
kind: Pod
metadata:
  name: debug-shell-${NODE_SLUG}
  namespace: cluster-support
  labels:
    app: node-debug-shell
spec:
  # Pinned to the node, which bypasses the scheduler: the shell reaches nodes
  # the scheduler would refuse, and needs no MKE scheduling grant.
  nodeName: "${NODE_NAME}"
  restartPolicy: Never
  serviceAccountName: default
  # nsenter --target 1 needs the host PID namespace; it also gives the
  # container the host's process table.
  hostPID: true
  # Uncomment to share the node's network or IPC namespace as well — needed for
  # host-level tcpdump/ss output and for inspecting host shared memory.
  # hostNetwork: true
  # hostIPC: true
  tolerations:
    # Untyped, key-less toleration: tolerates every taint, which is what
    # `kubectl debug` does for node debugging too. MKE 3 taints managers with
    # com.docker.ucp.manager:NoSchedule, not the upstream control-plane key, and
    # a cluster may carry others; a pinned pod bypasses the scheduler anyway, so
    # this exists to survive NoExecute taints rather than to get scheduled.
    - operator: Exists
  containers:
    - name: shell
      image: mirantis/ucp-dsinfo:3.9.7
      command: ["sleep", "infinity"]
      stdin: true
      tty: true
      securityContext:
        privileged: true
      volumeMounts:
        - name: host-root
          mountPath: /host
  volumes:
    - name: host-root
      hostPath:
        path: /
